# Copy to .env and fill in.

# Login password hash; leave empty to disable login (LAN/dev only).
# Generate with: scripts/dev.sh hash-password
HOMEBASE_PASSWORD_HASH=

# Session signing key (32+ chars); empty = random per restart (sessions reset).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HOMEBASE_SECRET_KEY=

# Strava app credentials from strava.com/settings/api (Client ID + Client Secret only).
# Don't add the access/refresh tokens shown there: they lack activity scope.
# The app gets its own tokens via "Connect Strava" and stores them in the DB.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin API key from developer.garmin.com
GARMIN_API_KEY=

# Your time zone (IANA name). The container defaults to UTC, which moves "today" (week
# boundaries, the plan, sync ranges) to the next day in the evening west of UTC.
TZ=UTC

# Optional
# HOMEBASE_LOG_LEVEL=INFO
# HOMEBASE_BACKUP_KEEP=7
# HOMEBASE_DATA_DIR=./data    # non-Docker runs only; the container uses /data
